{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EndfieldWebUIExportJob-2",
  "title": "Endfield WebUI bounded export job v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "map_id", "selection", "layers", "water_mode", "effects", "output"],
  "properties": {
    "format": {"const": "EndfieldWebUIExportJob/2"},
    "request_id": {"type": ["string", "null"]},
    "job_id": {"type": ["string", "null"], "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "map_id": {"type": "string", "enum": ["map01", "map02"]},
    "export_mode": {"type": "string", "enum": ["data_package", "blend"]},
    "batch_mode": {"type": "string", "enum": ["per_sector", "cluster_4x4_sectors", "merged_selection"]},
    "source": {
      "type": ["object", "null"], "additionalProperties": false,
      "required": ["game_root"],
      "properties": {
        "game_root": {"type": "string", "minLength": 1},
        "blender_exe": {"type": "string", "minLength": 1}
      }
    },
    "selection": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "umin", "umax", "vmin", "vmax"],
          "properties": {
            "type": {"const": "preview_rect"},
            "umin": {"type": "number", "minimum": 0, "maximum": 1},
            "umax": {"type": "number", "minimum": 0, "maximum": 1},
            "vmin": {"type": "number", "minimum": 0, "maximum": 1},
            "vmax": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "xmin", "xmax", "zmin", "zmax"],
          "properties": {
            "type": {"const": "world_bounds"},
            "xmin": {"type": "number"}, "xmax": {"type": "number"},
            "zmin": {"type": "number"}, "zmax": {"type": "number"}
          }
        }
      ]
    },
    "layers": {
      "type": "object", "additionalProperties": false,
      "required": ["terrain", "instances", "water", "effects"],
      "properties": {
        "terrain": {"type": "boolean"}, "instances": {"type": "boolean"},
        "roads": {"type": "boolean"}, "vegetation": {"type": "boolean"},
        "water": {"type": "boolean"}, "effects": {"type": "boolean"},
        "lights": {"type": "boolean"}
      }
    },
    "export_groups": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "enum": ["all", "building", "prop", "lighting", "particle", "vegetation", "terrain", "road", "water", "effects", "unknown"]}
    },
    "water_mode": {"type": "string", "enum": ["stable_eevee", "flowmap_fresnel"]},
    "fog_depth": {
      "type": "object", "required": ["subdivision_level"],
      "properties": {"subdivision_level": {"type": "integer", "minimum": 0, "maximum": 6}},
      "description": "Optional host-camera fog contact fading; requires Blender and effects export."
    },
    "scene_color_snapshot": {
      "type": "object",
      "required": ["format", "camera_matrix_world", "lens_mm", "resolution", "engine", "samples", "time_seconds", "clip_start", "clip_end"],
      "properties": {
        "format": {"const": "EndfieldSceneColorSnapshot/1"},
        "camera_matrix_world": {"type": "array", "items": {"type": "number"}, "minItems": 16, "maxItems": 16},
        "lens_mm": {"type": "number", "exclusiveMinimum": 0},
        "resolution": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 4096}, "minItems": 2, "maxItems": 2},
        "engine": {"type": "string", "enum": ["BLENDER_EEVEE_NEXT", "CYCLES"]},
        "samples": {"type": "integer", "minimum": 1, "maximum": 512},
        "time_seconds": {"type": "number", "minimum": 0},
        "clip_start": {"type": "number", "exclusiveMinimum": 0},
        "clip_end": {"type": "number", "exclusiveMinimum": 0}
      },
      "description": "Optional camera-bound host SceneColor snapshot recipe; requires Blender and effects export. Extra fields are ignored by the canonicalizer."
    },
    "water_transport_lighting": {
      "type": "object", "additionalProperties": true,
      "required": ["map_id", "entity_id", "ambient_radiance", "radiance_scale"],
      "properties": {
        "map_id": {"type": "string", "minLength": 1},
        "entity_id": {"type": "integer"},
        "ambient_radiance": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 3, "maxItems": 3},
        "radiance_scale": {"type": "number", "exclusiveMinimum": 0},
        "phase_atmosphere_rgb": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 3, "maxItems": 3},
        "ambient_l1": {
          "type": "object", "additionalProperties": true,
          "required": ["coefficients", "environment_global_scale"],
          "properties": {
            "coefficients": {
              "type": "array", "minItems": 3, "maxItems": 3,
              "items": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}
            },
            "environment_global_scale": {"type": "number"}
          }
        }
      }
    },
    "effects": {
      "type": "object", "additionalProperties": false,
      "required": ["selection_mode"],
      "properties": {
        "selection_mode": {"type": "string", "enum": ["full_system_by_anchor", "anchor_overlap", "all_active"]}
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["root"],
      "properties": {"root": {"type": "string", "minLength": 1}, "label": {"type": "string"}}
    }
  }
}
