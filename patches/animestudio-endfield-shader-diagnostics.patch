diff --git a/AnimeStudio.Utility/DxbcContainerValidator.cs b/AnimeStudio.Utility/DxbcContainerValidator.cs
new file mode 100644
index 0000000000000000000000000000000000000000..0cf22ec99bee99ce54eda4c555e2ecfb0a1fad53
--- /dev/null
+++ b/AnimeStudio.Utility/DxbcContainerValidator.cs
@@ -0,0 +1,177 @@
+using System;
+using System.Buffers.Binary;
+using System.Collections.Generic;
+using System.Text;
+
+namespace AnimeStudio
+{
+    public sealed class DxbcChunkInfo
+    {
+        public int Index { get; }
+        public string FourCC { get; }
+        public int Offset { get; }
+        public int Size { get; }
+
+        internal DxbcChunkInfo(int index, string fourCC, int offset, int size)
+        {
+            Index = index;
+            FourCC = fourCC;
+            Offset = offset;
+            Size = size;
+        }
+    }
+
+    public sealed class DxbcContainerInfo
+    {
+        public int Offset { get; }
+        public int Version { get; }
+        public int TotalSize { get; }
+        public IReadOnlyList<DxbcChunkInfo> Chunks { get; }
+
+        internal DxbcContainerInfo(
+            int offset,
+            int version,
+            int totalSize,
+            IReadOnlyList<DxbcChunkInfo> chunks)
+        {
+            Offset = offset;
+            Version = version;
+            TotalSize = totalSize;
+            Chunks = chunks;
+        }
+    }
+
+    public static class DxbcContainerValidator
+    {
+        private const int FixedHeaderSize = 32;
+        private const int MaxChunkCount = 128;
+
+        public static IReadOnlyList<DxbcContainerInfo> FindAll(ReadOnlySpan<byte> data)
+        {
+            var containers = new List<DxbcContainerInfo>();
+            for (var offset = 0; offset <= data.Length - FixedHeaderSize; offset++)
+            {
+                if (!HasMagic(data, offset))
+                {
+                    continue;
+                }
+
+                if (TryValidate(data, offset, out var container, out _))
+                {
+                    containers.Add(container);
+                    offset += container.TotalSize - 1;
+                }
+            }
+            return containers;
+        }
+
+        public static bool TryValidate(
+            ReadOnlySpan<byte> data,
+            int offset,
+            out DxbcContainerInfo container,
+            out string error)
+        {
+            container = null;
+            error = null;
+
+            if (offset < 0 || offset > data.Length - FixedHeaderSize)
+            {
+                error = "DXBC header is outside the source buffer";
+                return false;
+            }
+            if (!HasMagic(data, offset))
+            {
+                error = "DXBC magic is missing";
+                return false;
+            }
+
+            var version = BinaryPrimitives.ReadUInt32LittleEndian(data.Slice(offset + 20, 4));
+            var totalSize = BinaryPrimitives.ReadUInt32LittleEndian(data.Slice(offset + 24, 4));
+            var chunkCount = BinaryPrimitives.ReadUInt32LittleEndian(data.Slice(offset + 28, 4));
+            if (version != 1)
+            {
+                error = $"unsupported DXBC container version {version}";
+                return false;
+            }
+            if (totalSize < FixedHeaderSize || totalSize > int.MaxValue ||
+                totalSize > data.Length - offset)
+            {
+                error = $"invalid DXBC total size {totalSize}";
+                return false;
+            }
+            if (chunkCount < 1 || chunkCount > MaxChunkCount)
+            {
+                error = $"invalid DXBC chunk count {chunkCount}";
+                return false;
+            }
+
+            var chunkTableSize = checked((int)chunkCount * sizeof(uint));
+            var minimumChunkOffset = FixedHeaderSize + chunkTableSize;
+            if (minimumChunkOffset > totalSize)
+            {
+                error = "DXBC chunk table extends beyond the container";
+                return false;
+            }
+
+            var chunks = new List<DxbcChunkInfo>((int)chunkCount);
+            var ranges = new List<(int Start, int End)>((int)chunkCount);
+            for (var index = 0; index < chunkCount; index++)
+            {
+                var tableOffset = offset + FixedHeaderSize + checked((int)index * sizeof(uint));
+                var chunkOffsetValue = BinaryPrimitives.ReadUInt32LittleEndian(data.Slice(tableOffset, 4));
+                if (chunkOffsetValue < minimumChunkOffset ||
+                    chunkOffsetValue > totalSize - 8 ||
+                    chunkOffsetValue > int.MaxValue)
+                {
+                    error = $"DXBC chunk {index} has invalid offset {chunkOffsetValue}";
+                    return false;
+                }
+
+                var chunkOffset = (int)chunkOffsetValue;
+                var chunkHeader = data.Slice(offset + chunkOffset, 8);
+                var chunkSizeValue = BinaryPrimitives.ReadUInt32LittleEndian(chunkHeader.Slice(4, 4));
+                if (chunkSizeValue > int.MaxValue ||
+                    chunkSizeValue > totalSize - (uint)chunkOffset - 8)
+                {
+                    error = $"DXBC chunk {index} has invalid size {chunkSizeValue}";
+                    return false;
+                }
+
+                var fourCC = Encoding.ASCII.GetString(chunkHeader.Slice(0, 4));
+                for (var charIndex = 0; charIndex < fourCC.Length; charIndex++)
+                {
+                    if (fourCC[charIndex] < 0x20 || fourCC[charIndex] > 0x7e)
+                    {
+                        error = $"DXBC chunk {index} has a non-printable FourCC";
+                        return false;
+                    }
+                }
+
+                var chunkSize = (int)chunkSizeValue;
+                var range = (Start: chunkOffset, End: checked(chunkOffset + 8 + chunkSize));
+                foreach (var existing in ranges)
+                {
+                    if (range.Start < existing.End && existing.Start < range.End)
+                    {
+                        error = $"DXBC chunk {index} overlaps another chunk";
+                        return false;
+                    }
+                }
+
+                ranges.Add(range);
+                chunks.Add(new DxbcChunkInfo((int)index, fourCC, chunkOffset, chunkSize));
+            }
+
+            container = new DxbcContainerInfo(offset, (int)version, (int)totalSize, chunks);
+            return true;
+        }
+
+        private static bool HasMagic(ReadOnlySpan<byte> data, int offset)
+        {
+            return data[offset] == (byte)'D' &&
+                   data[offset + 1] == (byte)'X' &&
+                   data[offset + 2] == (byte)'B' &&
+                   data[offset + 3] == (byte)'C';
+        }
+    }
+}
