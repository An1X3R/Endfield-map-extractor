<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>AnimeStudio.CLI</AssemblyName>
    <RootNamespace>AnimeStudio.CLI</RootNamespace>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.10" />
    <ProjectReference Include="../PortableUtility/PortableUtility.csproj" />
    <Compile Include="$(AnimeStudioRoot)/AnimeStudio.CLI/**/*.cs" Exclude="$(AnimeStudioRoot)/AnimeStudio.CLI/**/obj/**;$(AnimeStudioRoot)/AnimeStudio.CLI/**/bin/**;$(AnimeStudioRoot)/AnimeStudio.CLI/**/obj-flat/**;$(AnimeStudioRoot)/AnimeStudio.CLI/**/bin-flat/**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="$(AnimeStudioRoot)/AnimeStudio.CLI/App.config" Link="App.config" />
    <None Include="$(AnimeStudioRoot)/AnimeStudio.CLI/Resources/ObjectIndexSchemaV1.json" Link="Resources/ObjectIndexSchemaV1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
