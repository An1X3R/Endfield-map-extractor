<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <Target Name="ValidateAnimeStudioRoot" BeforeTargets="Restore;Build">
    <Error Condition="'$(AnimeStudioRoot)' == ''" Text="ANIMESTUDIO_ROOT_MISSING: pass -p:AnimeStudioRoot=&lt;pinned checkout&gt;." />
    <Error Condition="!Exists('$(AnimeStudioRoot)\AnimeStudio\AnimeStudio.csproj')" Text="ANIMESTUDIO_ROOT_INVALID: AnimeStudio.csproj is missing under $(AnimeStudioRoot)." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="$(AnimeStudioRoot)\AnimeStudio\AnimeStudio.csproj" />
  </ItemGroup>
</Project>

